# Copy to .env for local runs. On Railway: Project > Variables. Never commit the real .env.
BUSINESS_NAME=Our Store
# Time zone for "today" and daily revenue in the owner dashboard
TIMEZONE=Asia/Kolkata
PORT=3000
# Where the database file lives. On Railway add a Volume mounted at /data and set DATA_DIR=/data
DATA_DIR=.data

# Payments: demo (for showing the client, no money moves) | upi (straight to the owner's UPI ID) | razorpay
PAYMENT_MODE=demo
# upi mode: the owner's UPI ID and the name shown in the payment app
UPI_ID=
UPI_PAYEE_NAME=
# ...or their printed QR image saved in site/ (used when UPI_ID is empty)
UPI_QR_IMAGE=
# razorpay mode: the OWNER's keys (Razorpay Dashboard > Account & Settings > API Keys).
# Use Test Mode keys (rzp_test_...) until the owner approves going live; test keys move no real money.
# If PAYMENT_MODE=razorpay but either key is missing or malformed, the site falls back to demo mode.
# Key id: public, starts rzp_test_ or rzp_live_ (the only Razorpay value the browser ever sees)
RAZORPAY_KEY_ID=
# Key secret: server only. Never put it in site/, never share it, never commit it.
RAZORPAY_KEY_SECRET=
# Webhook secret: you choose it when adding the webhook in Razorpay Dashboard > Webhooks.
# Webhook URL: https://<your-site>/api/webhooks/razorpay
# Events: payment.authorized, payment.captured, payment.failed, order.paid, qr_code.credited,
#         refund.created, refund.processed, refund.failed
RAZORPAY_WEBHOOK_SECRET=
# Optional tuning (defaults shown): per-call timeout in ms, retries on network errors / 5xx only
# RAZORPAY_TIMEOUT_MS=12000
# RAZORPAY_RETRIES=2

# Owner dashboard at /admin (password: at least 10 characters)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Keeps the owner logged in across restarts (any long random text)
SESSION_SECRET=
# Optional: the site's public address, e.g. https://shop.example.com
PUBLIC_URL=

